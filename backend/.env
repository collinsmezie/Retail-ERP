DATABASE_URL="file:./dev.db"
# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=retail_erp

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
