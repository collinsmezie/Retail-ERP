generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. 'tenant1'
  name      String
  isActive  Boolean  @default(true)
  modules   String   // comma-separated, e.g. 'inventory,sales,accounting'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  inventories   Inventory[]
  stockMovements StockMovement[]
  stockAdjustmentLogs StockAdjustmentLog[]
  stockInLogs StockInLog[]
  stockOutLogs StockOutLog[]
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  sku         String
  name        String
  description String?
  price       Float
  cost        Float    @default(0)
  category    String?
  brand       String?
  attributes  String?  // Changed from Json to String for SQLite compatibility
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory     Inventory[]
  StockMovement StockMovement[]
  StockAdjustmentLog StockAdjustmentLog[]
  StockInLog StockInLog[]
  StockOutLog StockOutLog[]

  @@unique([tenantId, sku])
}

model Inventory {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  productId        String
  quantity         Int       @default(0)
  location         String? // e.g. "Main Store", "Fridge A"
  batchNumber      String?
  expiryDate       DateTime?
  reservedQuantity Int       @default(0)
  reorderPoint     Int       @default(10)
  reorderQuantity  Int       @default(100)
  lastRestocked    DateTime?
  lastSold         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product       Product         @relation(fields: [productId], references: [id])
  StockMovement StockMovement[]
  StockAdjustmentLog StockAdjustmentLog[]
  StockInLog StockInLog[]
  StockOutLog StockOutLog[]

  @@unique([tenantId, productId])
}

model StockMovement {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  productId   String
  inventoryId String
  type        String   // Changed from enum to String for SQLite compatibility
  quantity    Int
  source      String? // e.g. 'PO #123', 'sale #456', 'manual'
  reason      String?
  reference   String?
  createdBy   String?
  createdAt   DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

model StockAdjustmentLog {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  productId       String
  inventoryId     String
  adjustmentType  String   // 'increase' or 'decrease'
  quantity        Int
  reason          String
  previousQuantity Int
  newQuantity     Int
  performedBy     String   // user ID
  timestamp       DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

model StockInLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  productId   String
  inventoryId String
  quantity    Int
  source      String   // 'supplier', 'warehouse', 'initial-stock'
  referenceId String?  // e.g., purchase order ID or transfer ID
  receivedBy  String   // user ID
  location    String?  // warehouse location
  batchNumber String?
  expiryDate  DateTime?
  notes       String?
  timestamp   DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

model StockOutLog {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  productId       String
  inventoryId     String
  quantity        Int
  destinationType String   // 'customer', 'warehouse', 'supplier'
  referenceId     String?  // e.g., sales order ID or transfer ID
  handledBy       String   // user ID who performed the dispatch
  locationId      String?  // origin warehouse
  notes           String?
  timestamp       DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  inventory Inventory @relation(fields: [inventoryId], references: [id])
}
