{
  "name": "retail-erp-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "client",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:client": "npm --workspace client run dev",
    "dev:shared": "npm --workspace shared run dev || echo 'No dev script for shared'",
    "build:backend": "npm --workspace backend run build",
    "build:client": "npm --workspace client run build",
    "build:shared": "npm --workspace shared run build || echo 'No build script for shared'"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7"
  }
}
